; Engine configuration file.
; 캐슬 M 3D 초안 — Godot 4.7 (Compatibility 렌더러: 안드로이드 폰 · 에뮬레이터 · CI 가상 화면 모두에서 돈다)

config_version=5

[application]

config/name="캐슬 M 3D"
config/description="castle M 3D 초안 — 엔진 이전(보류 결정 #9) 판단용"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

driver/enable_input=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Galmuri11-Bold.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.05, 1)
